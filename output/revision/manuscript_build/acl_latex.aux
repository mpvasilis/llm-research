\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Mean prompt-level union-proxy rate per condition (final models, $\tau =0.82$; each prompt averaged over 5 generations). Bold marks the cells that break the ``advice-specific'' reading: the empathy-opener proxy peaks on emotional \emph  {non-advice} prompts, and structuring is at ceiling on \emph  {neutral} advice. The audit sample shows substantial overprediction, suggesting upward-biased absolute rates (Section~\ref {sec:detval}); \texttt  {crisis\_referral} is excluded (0 TP / 11 FP in the 120-sentence audit).}}{6}{table.caption.12}\protected@file@percent }
\newlabel{tab:conditions}{{2}{6}{Mean prompt-level union-proxy rate per condition (final models, $\tau =0.82$; each prompt averaged over 5 generations). Bold marks the cells that break the ``advice-specific'' reading: the empathy-opener proxy peaks on emotional \emph {non-advice} prompts, and structuring is at ceiling on \emph {neutral} advice. The audit sample shows substantial overprediction, suggesting upward-biased absolute rates (Section~\ref {sec:detval}); \texttt {crisis\_referral} is excluded (0 TP / 11 FP in the 120-sentence audit)}{table.caption.12}{}}
\def\@LN@column{1}
